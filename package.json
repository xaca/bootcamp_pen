{
  "name": "orbit-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "predev": "npm run vendor",
    "dev": "vite",
    "prebuild": "npm run vendor",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-orbit \"vitest run tests\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "test": "vitest run src",
    "reset:classes": "node scripts/reset-firestore.mjs classes",
    "reset:all": "node scripts/reset-firestore.mjs all"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@uiw/react-codemirror": "^4.25.12",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "i18next": "^26.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.16",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@firebase/app": "0.16.2"
  }
}
